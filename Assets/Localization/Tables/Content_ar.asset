  - m_Id: 816832512
    m_Localized: "\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 833609728
    m_Localized: "\u0628\u062F\u0651\u0644 \u0628\u064A\u0646 \u0627\u0644\u0642\u0637\u0639 \u0627\u0644\u0645\u062A\u062C\u0627\u0648\u0631\u0629 \u0644\u062A\u062C\u0645\u0639 3 \u0623\u0634\u0643\u0627\u0644 \u0645\u062A\u0637\u0627\u0628\u0642\u0629 \u0623\u0648 \u0623\u0643\u062B\u0631 \u0641\u064A \u0635\u0641 \u0623\u0648 \u0639\u0645\u0648\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 837804032
    m_Localized: "\u0627\u0644\u0646\u062C\u0648\u0645 \u0627\u0644\u0645\u0632\u062F\u0648\u062C\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 837804033
    m_Localized: "\u0627\u0644\u0646\u062C\u0648\u0645 \u0627\u0644\u0645\u0632\u062F\u0648\u062C\u0629 \u062A\u0645\u0646\u0639 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0627\u062A. \u0643\u0648\u0651\u0646 \u0645\u0637\u0627\u0628\u0642\u0629 \u0628\u062C\u0627\u0646\u0628\u0647\u0627 \u0623\u0648 \u0627\u0633\u062A\u062E\u062F\u0645 \u0643\u0627\u0633\u0631 \u0627\u0644\u062E\u0637 \u0644\u062A\u062F\u0645\u064A\u0631\u0647\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 837804034
    m_Localized: "\u0643\u0627\u0633\u0631 \u0627\u0644\u062E\u0637"
    m_Metadata:
      m_Items: []
  - m_Id: 837804035
    m_Localized: "\u0637\u0627\u0628\u0642 4 \u0642\u0637\u0639 \u0623\u0648 \u0623\u0643\u062B\u0631 \u0641\u064A \u0635\u0641 \u0623\u0648 \u0639\u0645\u0648\u062F \u0644\u062A\u062F\u0645\u064A\u0631 \u0627\u0644\u062E\u0637 \u0628\u0627\u0644\u0643\u0627\u0645\u0644."
    m_Metadata:
      m_Items: []
  - m_Id: 837804036
    m_Localized: "\u0632\u0627\u0626\u062F"
    m_Metadata:
      m_Items: []
  - m_Id: 837804037
    m_Localized: "\u064A\u0645\u0646\u062D\u0643 \u0627\u0644\u0632\u0627\u0626\u062F \u062D\u0631\u0643\u0627\u062A \u0623\u0648 \u0648\u0642\u062A\u064B\u0627 \u0625\u0636\u0627\u0641\u064A\u064B\u0627. \u064A\u0645\u0643\u0646\u0643 \u062A\u0628\u062F\u064A\u0644\u0647 \u0623\u0648 \u062A\u0643\u0648\u064A\u0646 \u0645\u0637\u0627\u0628\u0642\u0627\u062A \u0628\u062C\u0627\u0646\u0628\u0647 \u0623\u0648 \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0643\u0627\u0633\u0631 \u0627\u0644\u062E\u0637."
    m_Metadata:
      m_Items: []
  - m_Id: 846192640
    m_Localized: "\u0627\u0644\u0646\u062C\u0648\u0645 \u0627\u0644\u0645\u0631\u0628\u0639\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 846192641
    m_Localized: "\u062A\u0633\u0642\u0637 \u0627\u0644\u0646\u062C\u0648\u0645 \u0627\u0644\u0645\u0631\u0628\u0639\u0629 \u0639\u0646\u062F\u0645\u0627 \u062A\u0643\u0648\u0651\u0646 \u0645\u0637\u0627\u0628\u0642\u0627\u062A \u062A\u062D\u062A\u0647\u0627. \u0648\u0627\u0635\u0644 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u062A\u062D\u062A\u0647\u0627 \u062D\u062A\u0649 \u062A\u0635\u0644 \u0625\u0644\u0649 \u0623\u0633\u0641\u0644 \u0627\u0644\u0634\u0628\u0643\u0629."
    m_Metadata:
      m_Items: []
