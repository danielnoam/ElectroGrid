    m_Localized: "\u05D1\u05D7\u05E8\u05D5 \u05E9\u05DC\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589514
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05D0\u05D7\u05D3 \u05D4\u05DB\u05E4\u05EA\u05D5\u05E8\u05D9\u05DD \u05DC\u05DE\u05D8\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D1\u05D7\u05D5\u05E8 \u05E9\u05DC\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589515
    m_Localized: "\u05DE\u05D8\u05E8\u05D5\u05EA:"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589516
    m_Localized: "\u05EA\u05E0\u05D0\u05D9 \u05D4\u05E4\u05E1\u05D3:"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589517
    m_Localized: "\u05E9\u05D9\u05D0:"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589523
    m_Localized: "\u05D4\u05E9\u05DC\u05D1 \u05D4\u05D1\u05D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589524
    m_Localized: "\u05E1\u05D9\u05D5\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589525
    m_Localized: "\u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589528
    m_Localized: "\u05DE\u05E9\u05D7\u05E7 \u05D7\u05D3\u05E9"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589529
    m_Localized: "\u05D4\u05DE\u05E9\u05DA"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589530
    m_Localized: "\u05D0\u05D9\u05E4\u05D5\u05E1 \u05D4\u05EA\u05E7\u05D3\u05DE\u05D5\u05EA"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589531
    m_Localized: "\u05DC\u05D7\u05E6\u05D5 \u05E9\u05D5\u05D1 \u05DC\u05D0\u05D9\u05E9\u05D5\u05E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589532
    m_Localized: "\u05D7\u05D3\u05E9!"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589533
    m_Localized: "\u05D4\u05D1\u05E0\u05EA\u05D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589534
    m_Localized: "\u05D9\u05E9 \u05E2\u05D3\u05DB\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589537
    m_Localized: "\u05D4\u05D5\u05E8\u05D9\u05D3\u05D5 \u05DE\u05D3\u05E3 \u05D4\u05D2\u05E8\u05E1\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589538
    m_Localized: "\u05E2\u05D3\u05DB\u05D5\u05DF"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589539
    m_Localized: "\u05E4\u05EA\u05D9\u05D7\u05EA \u05D4\u05D3\u05E3"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589540
    m_Localized: "\u05D4\u05EA\u05E7\u05E0\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589541
    m_Localized: "\u05D4\u05E4\u05E2\u05DC\u05D4 \u05DE\u05D7\u05D3\u05E9"
    m_Metadata:
      m_Items: []
  - m_Id: 1437589542
    m_Localized: "\u05DE\u05D5\u05E8\u05D9\u05D3..."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589544
    m_Localized: "\u05D4\u05D4\u05D5\u05E8\u05D3\u05D4 \u05D4\u05E1\u05EA\u05D9\u05D9\u05DE\u05D4. \u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05D4\u05EA\u05E7\u05E0\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589545
    m_Localized: "\u05D4\u05D4\u05D5\u05E8\u05D3\u05D4 \u05D4\u05E1\u05EA\u05D9\u05D9\u05DE\u05D4. \u05D4\u05DE\u05E9\u05D7\u05E7 \u05D9\u05D5\u05E4\u05E2\u05DC \u05DE\u05D7\u05D3\u05E9 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D9\u05D9\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589548
    m_Localized: "\u05D1\u05D3\u05D9\u05E7\u05EA \u05D4\u05D4\u05D5\u05E8\u05D3\u05D4 \u05E0\u05DB\u05E9\u05DC\u05D4. \u05E0\u05E1\u05D5 \u05E9\u05D5\u05D1."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589549
    m_Localized: "\u05D4\u05E2\u05D3\u05DB\u05D5\u05DF \u05E9\u05D4\u05D5\u05E8\u05D3 \u05D7\u05E1\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589550
    m_Localized: "\u05E2\u05D3\u05DB\u05D5\u05E0\u05D9\u05DD \u05DE\u05D5\u05EA\u05E7\u05E0\u05D9\u05DD \u05DE\u05EA\u05D5\u05DA build, \u05DC\u05D0 \u05DE\u05EA\u05D5\u05DA \u05D4\u05E2\u05D5\u05E8\u05DA."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589551
    m_Localized: "\u05D0\u05E4\u05E9\u05E8\u05D5 \u05DC-ElectroGrid \u05DC\u05D4\u05EA\u05E7\u05D9\u05DF \u05D0\u05E4\u05DC\u05D9\u05E7\u05E6\u05D9\u05D5\u05EA, \u05D7\u05D6\u05E8\u05D5 \u05D5\u05DC\u05D7\u05E6\u05D5 \u05E2\u05DC \u05D4\u05EA\u05E7\u05E0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589552
    m_Localized: "\u05E2\u05E7\u05D1\u05D5 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D4\u05EA\u05E7\u05E0\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05E2\u05D3\u05DB\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589554
    m_Localized: "\u05EA\u05D9\u05E7\u05D9\u05D9\u05EA \u05D4\u05D4\u05EA\u05E7\u05E0\u05D4 \u05E9\u05DC \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DC\u05D0 \u05E0\u05DE\u05E6\u05D0\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589555
    m_Localized: "\u05EA\u05D9\u05E7\u05D9\u05D9\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DE\u05D5\u05D2\u05E0\u05EA \u05DE\u05DB\u05EA\u05D9\u05D1\u05D4, \u05DC\u05DE\u05E9\u05DC \u05EA\u05D7\u05EA Program Files. \u05D4\u05E2\u05D1\u05D9\u05E8\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E9\u05D7\u05E7 \u05DC\u05EA\u05D9\u05E7\u05D9\u05D9\u05D4 \u05D0\u05D7\u05E8\u05EA \u05D0\u05D5 \u05E2\u05D3\u05DB\u05E0\u05D5 \u05DE\u05D3\u05E3 \u05D4\u05D2\u05E8\u05E1\u05D0\u05D5\u05EA."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589556
    m_Localized: "\u05DE\u05E4\u05E2\u05D9\u05DC \u05DE\u05D7\u05D3\u05E9 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05E2\u05D3\u05DB\u05D5\u05DF."
    m_Metadata:
      m_Items: []
  - m_Id: 2298687250432
