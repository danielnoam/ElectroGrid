  - m_Id: 1437589535
    m_Localized: "\u05D2\u05E8\u05E1\u05D4 {latest} \u05D6\u05DE\u05D9\u05E0\u05D4. \u05D4\u05D2\u05E8\u05E1\u05D4 \u05E9\u05DC\u05DB\u05DD \u05D4\u05D9\u05D0 {current}."
