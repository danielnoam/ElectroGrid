      m_Items: []
  - m_Id: 846192641
    m_Localized: "\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DE\u05E8\u05D5\u05D1\u05E2\u05D9\u05DD \u05E0\u05D5\u05E4\u05DC\u05D9\u05DD \u05DB\u05E9\u05D9\u05D5\u05E6\u05E8\u05D9\u05DD \u05D4\u05EA\u05D0\u05DE\u05D5\u05EA \u05DE\u05EA\u05D7\u05EA\u05D9\u05D4\u05DD. \u05D4\u05DE\u05E9\u05D9\u05DB\u05D5 \u05DC\u05D4\u05EA\u05D0\u05D9\u05DD \u05DE\u05EA\u05D7\u05EA\u05DD \u05E2\u05D3 \u05E9\u05D9\u05D2\u05D9\u05E2\u05D5 \u05DC\u05EA\u05D7\u05EA\u05D9\u05EA \u05D4\u05DC\u05D5\u05D7."
