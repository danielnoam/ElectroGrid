  - m_Id: 833609728
    m_Localized: "\u05D4\u05D7\u05DC\u05D9\u05E4\u05D5 \u05D1\u05D9\u05DF \u05D7\u05DC\u05E7\u05D9\u05DD \u05E1\u05DE\u05D5\u05DB\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D9\u05E6\u05D5\u05E8 \u05E9\u05D5\u05E8\u05D4 \u05D0\u05D5 \u05D8\u05D5\u05E8 \u05E9\u05DC 3 \u05E6\u05D5\u05E8\u05D5\u05EA \u05D6\u05D4\u05D5\u05EA \u05D0\u05D5 \u05D9\u05D5\u05EA\u05E8."
    m_Metadata:
      m_Items: []
  - m_Id: 837804032
    m_Localized: "\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DB\u05E4\u05D5\u05DC\u05D9\u05DD"
    m_Metadata:
      m_Items: []
  - m_Id: 837804033
    m_Localized: "\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DB\u05E4\u05D5\u05DC\u05D9\u05DD \u05D7\u05D5\u05E1\u05DE\u05D9\u05DD \u05D4\u05EA\u05D0\u05DE\u05D5\u05EA. \u05E6\u05E8\u05D5 \u05D4\u05EA\u05D0\u05DE\u05D4 \u05DC\u05D9\u05D3\u05DD \u05D0\u05D5 \u05D4\u05E9\u05EA\u05DE\u05E9\u05D5 \u05D1\u05E9\u05D5\u05D1\u05E8 \u05E9\u05D5\u05E8\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E9\u05DE\u05D9\u05D3 \u05D0\u05D5\u05EA\u05DD."
    m_Metadata:
      m_Items: []
  - m_Id: 837804034
    m_Localized: "\u05E9\u05D5\u05D1\u05E8 \u05E9\u05D5\u05E8\u05D4"
    m_Metadata:
      m_Items: []
  - m_Id: 837804035
    m_Localized: "\u05D4\u05EA\u05D0\u05D9\u05DE\u05D5 4 \u05D7\u05DC\u05E7\u05D9\u05DD \u05D0\u05D5 \u05D9\u05D5\u05EA\u05E8 \u05D1\u05E9\u05D5\u05E8\u05D4 \u05D0\u05D5 \u05D1\u05D8\u05D5\u05E8 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E9\u05DE\u05D9\u05D3 \u05D0\u05EA \u05DB\u05DC \u05D4\u05E7\u05D5."
    m_Metadata:
      m_Items: []
  - m_Id: 837804036
    m_Localized: "\u05E4\u05DC\u05D5\u05E1"
    m_Metadata:
      m_Items: []
  - m_Id: 837804037
    m_Localized: "\u05D4\u05E4\u05DC\u05D5\u05E1 \u05E0\u05D5\u05EA\u05DF \u05DE\u05D4\u05DC\u05DB\u05D9\u05DD \u05D0\u05D5 \u05D6\u05DE\u05DF \u05E0\u05D5\u05E1\u05E4\u05D9\u05DD. \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05D6\u05D9\u05D6 \u05D0\u05D5\u05EA\u05D5, \u05DC\u05D9\u05E6\u05D5\u05E8 \u05D4\u05EA\u05D0\u05DE\u05D5\u05EA \u05DC\u05D9\u05D3\u05D5 \u05D0\u05D5 \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05E9\u05D5\u05D1\u05E8 \u05E9\u05D5\u05E8\u05D4."
    m_Metadata:
      m_Items: []
  - m_Id: 846192640
    m_Localized: "\u05DB\u05D5\u05DB\u05D1\u05D9\u05DD \u05DE\u05E8\u05D5\u05D1\u05E2\u05D9\u05DD"
