  m_TableData:
  - m_Id: 816832512
    m_Localized: Grundlagen
    m_Metadata:
      m_Items: []
  - m_Id: 833609728
    m_Localized: Tausche benachbarte Teile, um 3 oder mehr gleiche Formen in einer Reihe oder Spalte zu verbinden.
    m_Metadata:
      m_Items: []
  - m_Id: 837804032
    m_Localized: Doppelsterne
    m_Metadata:
      m_Items: []
  - m_Id: 837804033
    m_Localized: "Doppelsterne blockieren deine Kombinationen. Bilde daneben eine Kombination oder nutze einen Linienbrecher, um sie zu zerst\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 837804034
    m_Localized: Linienbrecher
    m_Metadata:
      m_Items: []
  - m_Id: 837804035
    m_Localized: "Verbinde 4 oder mehr Teile in einer Reihe oder Spalte, um die ganze Linie zu zerst\xF6ren."
    m_Metadata:
      m_Items: []
  - m_Id: 837804036
    m_Localized: Plus
    m_Metadata:
      m_Items: []
  - m_Id: 837804037
    m_Localized: "Plus gibt dir zus\xE4tzliche Z\xFCge oder Zeit. Du kannst es tauschen, daneben Kombinationen bilden oder einen Linienbrecher nutzen."
    m_Metadata:
      m_Items: []
  - m_Id: 846192640
    m_Localized: Quadratsterne
    m_Metadata:
      m_Items: []
  - m_Id: 846192641
    m_Localized: Quadratsterne fallen, wenn du unter ihnen Kombinationen bildest. Kombiniere weiter darunter, bis sie den unteren Rand des Rasters erreichen.
    m_Metadata:
      m_Items: []
  - m_Id: 846192642
    m_Localized: Kreis
    m_Metadata:
      m_Items: []
  - m_Id: 846192643
    m_Localized: Sechseck
    m_Metadata:
      m_Items: []
  - m_Id: 846192644
    m_Localized: "F\xFCnfeck"
    m_Metadata:
      m_Items: []
  - m_Id: 846192645
    m_Localized: Dreieck
    m_Metadata:
      m_Items: []
