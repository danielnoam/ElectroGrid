      m_Items: []
  - m_Id: 1437589542
    m_Localized: Wird geladen...
    m_Metadata:
      m_Items: []
  - m_Id: 1437589544
    m_Localized: "Geladen. Tippe auf Installieren, um abzuschlie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589545
    m_Localized: "Geladen. Das Spiel startet zum Abschlie\xDFen neu."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589548
    m_Localized: "Die Pr\xFCfsumme des Downloads stimmt nicht. Versuch es nochmal."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589549
    m_Localized: Das geladene Update fehlt.
    m_Metadata:
      m_Items: []
  - m_Id: 1437589550
    m_Localized: Updates werden aus einem Build installiert, nicht im Editor.
    m_Metadata:
      m_Items: []
  - m_Id: 1437589551
    m_Localized: "Erlaube ElectroGrid, Apps zu installieren, komm dann zur\xFCck und tippe auf Installieren."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589552
    m_Localized: "Folge dem Installer, um das Update abzuschlie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589554
    m_Localized: Der Installationsordner des Spiels wurde nicht gefunden.
    m_Metadata:
      m_Items: []
  - m_Id: 1437589555
    m_Localized: "Der Ordner des Spiels ist schreibgesch\xFCtzt, zum Beispiel unter Programme. Verschiebe das Spiel in einen anderen Ordner oder aktualisiere \xFCber die Release-Seite."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589556
    m_Localized: "Neustart, um das Update abzuschlie\xDFen."
