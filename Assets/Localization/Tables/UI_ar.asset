    m_Metadata:
      m_Items: []
  - m_Id: 1437589542
    m_Localized: "\u062C\u0627\u0631\u064D \u0627\u0644\u062A\u0646\u0632\u064A\u0644..."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589544
    m_Localized: "\u0627\u0643\u062A\u0645\u0644 \u0627\u0644\u062A\u0646\u0632\u064A\u0644. \u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A \u0644\u0644\u0625\u0646\u0647\u0627\u0621."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589545
    m_Localized: "\u0627\u0643\u062A\u0645\u0644 \u0627\u0644\u062A\u0646\u0632\u064A\u0644. \u0633\u062A\u064F\u0639\u0627\u062F \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0644\u0644\u0625\u0646\u0647\u0627\u0621."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589548
    m_Localized: "\u0641\u0634\u0644 \u0627\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0627\u0644\u062A\u0646\u0632\u064A\u0644. \u062D\u0627\u0648\u0644 \u0645\u062C\u062F\u062F\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589549
    m_Localized: "\u0627\u0644\u062A\u062D\u062F\u064A\u062B \u0627\u0644\u0630\u064A \u062A\u0645 \u062A\u0646\u0632\u064A\u0644\u0647 \u0645\u0641\u0642\u0648\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589550
    m_Localized: "\u062A\u064F\u062B\u0628\u064E\u0651\u062A \u0627\u0644\u062A\u062D\u062F\u064A\u062B\u0627\u062A \u0645\u0646 \u0646\u0633\u062E\u0629 \u0645\u0628\u0646\u064A\u0629\u060C \u0648\u0644\u064A\u0633 \u0645\u0646 \u0627\u0644\u0645\u062D\u0631\u0631."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589551
    m_Localized: "\u0627\u0633\u0645\u062D \u0644\u0640 ElectroGrid \u0628\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A\u060C \u062B\u0645 \u0639\u062F \u0648\u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589552
    m_Localized: "\u0627\u062A\u0628\u0639 \u062E\u0637\u0648\u0627\u062A \u0627\u0644\u0645\u062B\u0628\u0651\u062A \u0644\u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u062A\u062D\u062F\u064A\u062B."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589554
    m_Localized: "\u062A\u0639\u0630\u0651\u0631 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u0649 \u0645\u062C\u0644\u062F \u062A\u062B\u0628\u064A\u062A \u0627\u0644\u0644\u0639\u0628\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589555
    m_Localized: "\u0645\u062C\u0644\u062F \u0627\u0644\u0644\u0639\u0628\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0641\u0642\u0637\u060C \u0645\u062B\u0644\u064B\u0627 \u062F\u0627\u062E\u0644 Program Files. \u0627\u0646\u0642\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0625\u0644\u0649 \u0645\u062C\u0644\u062F \u0622\u062E\u0631 \u0623\u0648 \u062D\u062F\u0651\u062B\u0647\u0627 \u0645\u0646 \u0635\u0641\u062D\u0629 \u0627\u0644\u0625\u0635\u062F\u0627\u0631\u0627\u062A."
    m_Metadata:
      m_Items: []
  - m_Id: 1437589556
