  m_Name: Content_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 3e9d6025d4245e94282bbdd919393591, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 816832512
    m_Localized: Les bases
    m_Metadata:
      m_Items: []
  - m_Id: 833609728
    m_Localized: "\xC9change des pi\xE8ces voisines pour aligner au moins 3 formes identiques sur une ligne ou une colonne."
    m_Metadata:
      m_Items: []
  - m_Id: 837804032
    m_Localized: "\xC9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 837804033
    m_Localized: "Les \xE9toiles bloquent tes combinaisons. Chacune demande deux coups : fais des combinaisons \xE0 c\xF4t\xE9, ou utilise un brise-ligne pour la d\xE9truire d'un coup."
    m_Metadata:
      m_Items: []
  - m_Id: 837804034
    m_Localized: Brise-ligne
    m_Metadata:
      m_Items: []
  - m_Id: 837804035
    m_Localized: "Aligne au moins 4 pi\xE8ces sur une ligne ou une colonne pour d\xE9truire toute la ligne."
    m_Metadata:
      m_Items: []
  - m_Id: 837804036
    m_Localized: Plus
    m_Metadata:
      m_Items: []
  - m_Id: 837804037
    m_Localized: "Le Plus te donne des coups ou du temps en plus. Tu peux l'\xE9changer, faire des combinaisons \xE0 c\xF4t\xE9 ou utiliser un brise-ligne."
    m_Metadata:
      m_Items: []
  - m_Id: 846192640
    m_Localized: Prises
    m_Metadata:
      m_Items: []
  - m_Id: 846192641
    m_Localized: "Les prises tombent quand tu fais des combinaisons en dessous. Continue \xE0 combiner en dessous jusqu'\xE0 ce qu'elles se branchent en bas de la grille."
    m_Metadata:
      m_Items: []
  - m_Id: 846192642
    m_Localized: Cercle
    m_Metadata:
      m_Items: []
  - m_Id: 846192643
    m_Localized: Hexagone
    m_Metadata:
      m_Items: []
  - m_Id: 846192644
    m_Localized: Pentagone
    m_Metadata:
      m_Items: []
  - m_Id: 846192645
    m_Localized: Triangle
    m_Metadata:
      m_Items: []
  - m_Id: 1708965854437376
    m_Localized: Survie
    m_Metadata:
      m_Items: []
  - m_Id: 1708965875408896
    m_Localized: "Marque un maximum de points avant la fin du chrono. Le Plus et les \xE9toiles ajoutent du temps, et ton combo multiplie chaque point."
    m_Metadata:
      m_Items: []
  - m_Id: 2532849646297088
    m_Localized: Barre de combo
    m_Metadata:
      m_Items: []
  - m_Id: 2532849679851520
    m_Localized: "Encha\xEEne vite les combinaisons pour augmenter ton combo et remplir la barre de combo. Ton combo multiplie chaque point que tu marques."
    m_Metadata:
      m_Items: []
  - m_Id: 3159364713046016
    m_Localized: Bugs
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600448
    m_Localized: "Les cases bugu\xE9es clignotent. Fais une combinaison sur un bug ou touche-le avec un brise-ligne pour l'effacer."
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600449
    m_Localized: Virus
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600450
    m_Localized: "Les virus bloquent tes combinaisons comme les \xE9toiles, mais \xE0 chaque coup o\xF9 tu n'en d\xE9truis aucun, un virus se propage sur une pi\xE8ce voisine."
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600451
    m_Localized: "M\xE8ches"
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600452
    m_Localized: "Une m\xE8che baisse d'un \xE0 chaque coup. Combine sa pi\xE8ce avant qu'elle n'arrive \xE0 0, sinon le niveau est perdu."
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600453
    m_Localized: Tapis roulants
    m_Metadata:
      m_Items: []
  - m_Id: 3159364746600454
    m_Localized: "Les rang\xE9es fl\xE9ch\xE9es avancent d'une case apr\xE8s chaque coup. Les pi\xE8ces qui arrivent au bout reviennent par le d\xE9but."
    m_Metadata:
      m_Items: []
  - m_Id: 3274541252993024
    m_Localized: Losange
    m_Metadata:
      m_Items: []
  - m_Id: 3275166833434624
    m_Localized: Losange turquoise
    m_Metadata:
      m_Items: []
  - m_Id: 3277096200691712
    m_Localized: "Trap\xE8ze"
    m_Metadata:
      m_Items: []
  - m_Id: 3659092647206912
    m_Localized: Surtensions
    m_Metadata:
      m_Items: []
  - m_Id: 3659092676567040
    m_Localized: "Aligne 5 pi\xE8ces pour cr\xE9er une Surtension. \xC9change-la avec une voisine pour d\xE9truire toutes les pi\xE8ces du type qu'elle contient."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
